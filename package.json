{
  "name": "movecast",
  "title": "MoveCast",
  "description": "Movement Labs at your command everything at your fingertips",
  "icon": "extension-icon.png",
  "author": "nisarg_thakkar",
  "access": "public",
  "owner": "nisarg_thakkar",
  "categories": [
    "Productivity",
    "Finance"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "MoveCast",
      "description": "Launch MoveCast",
      "mode": "view"
    },
    {
      "name": "get-wallet",
      "title": "Wallet",
      "subtitle": "MoveCast",
      "description": "Get your Move wallet",
      "mode": "view"
    },
    {
      "name": "get-token-overview",
      "title": "Token Overview",
      "subtitle": "MoveCast",
      "description": "Get information about a specific Move token",
      "mode": "view",
      "arguments": [
        {
          "name": "tokenAddress",
          "type": "text",
          "title": "Token Address",
          "placeholder": "Enter token address",
          "required": true
        }
      ]
    },
    {
      "name": "get-portfolio",
      "title": "Portfolio",
      "subtitle": "MoveCast",
      "description": "View your token portfolio",
      "mode": "view"
    },
    {
      "name": "sign-out",
      "title": "Sign Out",
      "subtitle": "MoveCast",
      "description": "Sign out of MoveCast",
      "mode": "no-view"
    }
  ],
  "dependencies": {
    "@aptos-labs/ts-sdk": "^5.2.0",
    "@raycast/api": "^1.92.0",
    "@raycast/utils": "^1.19.1",
    "axios": "^1.13.2"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/node": "22.13.9",
    "@types/react": "19.0.10",
    "eslint": "^8.57.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "ray publish",
    "pull": "ray pull-contributions"
  }
}
